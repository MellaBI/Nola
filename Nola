}

/* ---------- study ---------- */
function renderStudy(){
  var box=$('#studyBody'),d=deck(),s=state.settings;
  if(study&&study.phase==='run')return renderStudyRun(box);
  if(study&&study.phase==='done')return renderStudyDone(box);
  if(!d.cards.length){box.innerHTML=emptyDeck();return}
  var base=d.cards.filter(function(c){return usable(c,s.dir)});
  var pool=base.filter(function(c){return s.inclMastered||c.lv<3});
  var nOpts=[10,20,50,'all'].map(function(n){return '<option value="'+n+'"'+(String(s.studyN)===String(n)?' selected':'')+'>'+(n==='all'?'All cards':n+' cards')+'</option>'}).join('');
  box.innerHTML=
    '<div class="panel start"><h2>Study session</h2>'+
    '<p class="lead">'+(pool.length?pl(pool.length,'card')+' ready to review. New and shaky cards come first.':!base.length?'No cards in this deck have pinyin yet. Add pinyin or switch the order.':'Every card in this deck is mastered. Include mastered cards to keep practising.')+'</p>'+
    '<div class="opts-grid">'+dirSelect('studyDir')+
    '<label class="field"><span>Session length</span><select id="studyN" data-set="studyN">'+nOpts+'</select></label></div>'+
    pyCheck('studyPy')+
    '<label class="check"><input type="checkbox" id="inclMastered" data-set="inclMastered"'+(s.inclMastered?' checked':'')+'> Include mastered cards</label>'+
    '<div class="row-btns"><button class="btn primary big" type="button" data-act="startStudy"'+(pool.length?'':' disabled')+'>Start studying</button></div></div>';
}
function faceHTML(label,text,cls,sub){
  return '<div class="face '+cls+'"><div class="face-head"><span class="eyebrow">'+label+'</span></div><div class="face-body '+lenClass(text)+'"><span'+(/[㐀-鿿]/.test(text)?' lang="zh-Hans"':'')+'>'+esc(text)+'</span>'+(sub?'<span class="face-sub">'+esc(sub)+'</span>':'')+'</div></div>';
}
function studyActionsHTML(){
  if(!study.flipped)return '<button class="btn primary big only" type="button" data-act="flip">Show answer</button>';
  return '<button class="btn again big" type="button" data-act="again">Again</button><button class="btn primary big" type="button" data-act="good">Got it</button>';
}
function renderStudyRun(box){
  var c=cardById(study.queue[0]);
  if(!c){study.phase='done';return renderStudyDone(box)}
  var sd=sideOf(c,state.settings.dir);
  var left=new Set(study.queue).size,pos=study.total-left+1;
  var pct=Math.round((study.total-left)/study.total*100);
  box.innerHTML=
    '<div class="session-head"><span>Card '+pos+' of '+study.total+'</span><button class="btn ghost small" type="button" data-act="endStudy">End session</button></div>'+
    '<div class="minibar" aria-hidden="true"><span style="width:'+pct+'%"></span></div>'+
    '<div class="flip'+(study.flipped?' flipped':'')+'" id="flipCard" role="button" tabindex="0" aria-label="Flip card" data-act="flip"><div class="flip-inner">'+
      faceHTML(sd.pl,sd.p,'front',sd.fsub)+faceHTML(sd.al,sd.a,'back',sd.sub)+
    '</div></div>'+
    '<div class="actions" id="studyActions"></div>'+
    '<p class="hint"><kbd>Space</kbd> flip · <kbd>1</kbd> again · <kbd>2</kbd> got it</p>';
  syncStudyFlip();
  focusSoon($('#flipCard'));
}
function syncStudyFlip(){
  var el=$('#flipCard');if(!el)return;
  el.classList.toggle('flipped',study.flipped);
  var f=$('.face.front',el),b=$('.face.back',el);
  if(f)f.setAttribute('aria-hidden',study.flipped?'true':'false');
  if(b)b.setAttribute('aria-hidden',study.flipped?'false':'true');
  $('#studyActions').innerHTML=studyActionsHTML();
}
function renderStudyDone(box){
  var d=deck(),m=d.cards.filter(function(c){return c.lv===3}).length;
  box.innerHTML=
    '<div class="panel results"><h2>Session complete</h2>'+
    '<p><span class="score">'+study.right+'<small> got it</small></span></p>'+
    '<p class="lead">'+pl(study.again,'card')+' marked Again. '+m+' of '+d.cards.length+' cards are mastered.</p>'+
    '<div class="row-btns"><button class="btn primary" type="button" data-act="studyAgain">Study again</button>'+
    '<button class="btn" type="button" data-act="toTest">Take a test</button>'+
    '<button class="btn ghost" type="button" data-act="studyHome">Back</button></div></div>';
}
function startStudy(){
  var d=deck(),s=state.settings;
  var pool=d.cards.filter(function(c){return (s.inclMastered||c.lv<3)&&usable(c,s.dir)});
  pool=shuffle(pool.slice()).sort(function(a,b){return a.lv-b.lv});
  if(s.studyN!=='all')pool=pool.slice(0,+s.studyN);
  if(!pool.length)return;
  study={phase:'run',queue:pool.map(function(c){return c.id}),total:pool.length,flipped:false,right:0,again:0,requeued:{}};
  renderStudy();
}
function flipStudy(){
  if(!study||study.phase!=='run')return;
  study.flipped=!study.flipped;syncStudyFlip();
}
function answerStudy(ok){
  if(!study||study.phase!=='run'||!study.flipped)return;
  var id=study.queue.shift(),c=cardById(id);
  if(c){applyResult(c,ok,!!study.requeued[id])}
  if(ok)study.right++;
  else{
    study.again++;
    if(!study.requeued[id]){study.requeued[id]=1;study.queue.splice(Math.min(3,study.queue.length),0,id)}
  }
  study.flipped=false;
  if(!study.queue.length)study.phase='done';
  persist();renderProgress();renderStudy();
}

/* ---------- test ---------- */
function prepQuestion(){
  var d=deck(),id=test.items[test.i],c=cardById(id);
  var cur={id:id,checked:false,correct:null,close:false,given:'',picked:null,options:null};
  if(test.mode==='mc'){
    var ans=sideOf(c,test.dir).a,seen={},opts=[];
    seen[norm(ans)]=1;
    shuffle(d.cards.filter(function(x){return x.id!==c.id&&usable(x,test.dir)}).slice()).forEach(function(x){
      var a=sideOf(x,test.dir).a,k=norm(a);
      if(opts.length<3&&!seen[k]){seen[k]=1;opts.push({id:x.id,text:a})}
    });
    opts.push({id:c.id,text:ans});
    cur.options=shuffle(opts);
  }
  test.cur=cur;
}
function startTest(ids){
  var d=deck(),s=state.settings,cards;
  if(ids){cards=ids.map(cardById).filter(Boolean)}
  else{cards=shuffle(d.cards.filter(function(c){return usable(c,s.dir)}));if(s.testN!=='all')cards=cards.slice(0,+s.testN)}
  if(!cards.length){toast('No cards have pinyin yet. Add pinyin or pick another order.');return}
  var mode=s.testMode;
  if(mode==='mc'&&d.cards.length<2){mode='type';toast('Multiple choice needs at least 2 cards. Using typed answers.')}
  test={phase:'ask',items:cards.map(function(c){return c.id}),i:0,mode:mode,dir:s.dir,results:[],cur:null};
  prepQuestion();renderTest();
}
function renderTest(){
  var box=$('#testBody'),d=deck(),s=state.settings;
  if(test&&test.phase==='ask')return renderTestAsk(box);
  if(test&&test.phase==='results')return renderTestResults(box);
  if(!d.cards.length){box.innerHTML=emptyDeck();return}
  var nOpts=[5,10,20,'all'].map(function(n){return '<option value="'+n+'"'+(String(s.testN)===String(n)?' selected':'')+'>'+(n==='all'?'All '+d.cards.length+' cards':n+' questions')+'</option>'}).join('');
  var recent=d.tests.slice(-5).reverse().map(function(t){return '<li>'+esc(fmtDate(t.at))+' · '+t.score+'/'+t.total+' · '+Math.round(t.score/t.total*100)+'% · '+(t.mode==='mc'?'multiple choice':'typed')+'</li>'}).join('');
  box.innerHTML=
    '<div class="panel start"><h2>Test yourself</h2>'+
    '<p class="lead">Answer without peeking. Right answers move a card up a level, wrong ones send it back to Learning.</p>'+
    '<div class="opts-grid">'+dirSelect('testDir')+
    '<label class="field"><span>Questions</span><select id="testN" data-set="testN">'+nOpts+'</select></label>'+
    '<label class="field"><span>Format</span><select id="testMode" data-set="testMode"><option value="type"'+(s.testMode==='type'?' selected':'')+'>Type the answer</option><option value="mc"'+(s.testMode==='mc'?' selected':'')+'>Multiple choice</option></select></label></div>'+
    pyCheck('testPy')+
    '<div class="row-btns"><button class="btn primary big" type="button" data-act="startTest">Start test</button></div></div>'+
    (recent?'<div class="recent"><h3>Recent tests</h3><ul>'+recent+'</ul></div>':'');
}
function renderTestAsk(box){
  var c=cardById(test.cur.id),cur=test.cur;
  if(!c){test.i++;if(test.i>=test.items.length)return finishTest();prepQuestion();return renderTestAsk(box)}
  var sd=sideOf(c,test.dir),n=test.items.length,pct=Math.round(test.i/n*100);
  var html=
    '<div class="session-head"><span>Question '+(test.i+1)+' of '+n+'</span><button class="btn ghost small" type="button" data-act="quitTest">Quit test</button></div>'+
    '<div class="minibar" aria-hidden="true"><span style="width:'+pct+'%"></span></div>'+
    faceHTML(sd.pl,sd.p,'solo',sd.fsub);
  if(test.mode==='type'){
    html+='<form class="answer-form" id="answerForm"><label class="label" for="answerInput">'+askLabel(test.dir)+'</label>'+
      '<input type="text" class="answer-input" id="answerInput" autocomplete="off" autocapitalize="off" spellcheck="false" value="'+esc(cur.given)+'"'+(cur.checked?' readonly':'')+'>';
    if(!cur.checked)html+='<div class="row-btns"><button class="btn primary" type="submit">Check</button><button class="btn ghost" type="button" data-act="dontKnow">I don\'t know</button></div>';
    html+='</form>';
  }else{
    html+='<div class="opts" id="opts">'+cur.options.map(function(o,i){
      var cls='opt';
      if(cur.checked){if(o.id===c.id)cls+=' right';else if(cur.picked===i)cls+=' wrong'}
      return '<button type="button" class="'+cls+'" data-act="pick" data-i="'+i+'"'+(cur.checked?' disabled':'')+'><span class="k">'+(i+1)+'</span><span>'+esc(o.text)+'</span></button>';
    }).join('')+'</div>';
  }
  if(cur.checked){
    var title=cur.correct?(cur.close?(test.dir==='tp'?'Correct, check the tones':'Correct, check the accents'):'Correct'):'Not quite';
    html+='<div class="feedback '+(cur.correct?'ok':'bad')+'"><span class="fb-title">'+title+'</span>'+
      '<span>Answer: <span class="ans">'+esc(sd.a)+'</span></span>'+(sd.sub?'<span class="muted">'+esc(sd.sub)+'</span>':'')+
      (!cur.correct&&cur.given?'<span class="muted">You wrote: '+esc(cur.given)+'</span>':'')+
      (!cur.correct&&test.mode==='type'?'<div class="row-btns"><button class="btn small" type="button" data-act="override">Count as correct</button></div>':'')+
      '</div>'+
      '<div class="row-btns"><button class="btn primary big" type="button" id="nextQ" data-act="next">'+(test.i+1>=n?'See results':'Next question')+'</button></div>';
  }
  box.innerHTML=html;
  if(cur.checked)focusSoon($('#nextQ'));
  else if(test.mode==='type')focusSoon($('#answerInput'));
}
function checkTyped(skip){
  var cur=test.cur;if(cur.checked)return;
  var c=cardById(cur.id),inp=$('#answerInput');
  var given=skip?'':(inp?inp.value:'');
  if(!skip&&!given.trim()){toast('Type an answer, or choose I don\'t know.');return}
  var r=judge(given,sideOf(c,test.dir).a,test.dir==='tp');
  cur.checked=true;cur.given=given.trim();cur.correct=r.ok;cur.close=r.close;
  renderTestAsk($('#testBody'));
}
function pickOption(i){
  var cur=test.cur;if(cur.checked||!cur.options||!cur.options[i])return;
  cur.checked=true;cur.picked=i;cur.given=cur.options[i].text;cur.correct=cur.options[i].id===cur.id;
  renderTestAsk($('#testBody'));
}
function nextQuestion(){
  var cur=test.cur;if(!cur||!cur.checked)return;
  var c=cardById(cur.id);
  if(c)applyResult(c,cur.correct,false);
  test.results.push({id:cur.id,given:cur.given,correct:!!cur.correct});
  test.i++;
  if(test.i>=test.items.length){finishTest()}
  else{prepQuestion();persist();renderProgress();renderTest();return}
  persist();renderProgress();
}
function finishTest(){
  var d=deck(),score=test.results.filter(function(r){return r.correct}).length;
  d.tests.push({at:Date.now(),score:score,total:test.results.length,mode:test.mode,dir:test.dir});
  d.tests=d.tests.slice(-20);
  test.phase='results';test.score=score;
  persist();renderProgress();renderTest();
}
function renderTestResults(box){
  var n=test.results.length,pct=n?Math.round(test.score/n*100):0;
  var missed=test.results.filter(function(r){return !r.correct});
  var msg=pct===100?'Perfect score.':pct>=80?'Strong result.':pct>=50?'Getting there. The missed cards are back in Learning.':'Keep going. The missed cards are back in Learning.';
  box.innerHTML=
    '<div class="panel results"><h2>Test finished</h2>'+
    '<p><span class="score">'+test.score+'<small> / '+n+' · '+pct+'%</small></span></p><p class="lead">'+msg+'</p>'+
    (missed.length?'<ul class="missed">'+missed.map(function(r){
      var c=cardById(r.id);if(!c)return '';var sd=sideOf(c,test.dir);
      return '<li><span class="p">'+esc(sd.p)+'</span><span>'+esc(sd.a)+'</span>'+(r.given?'<span class="g">You wrote: '+esc(r.given)+'</span>':'')+'</li>';
    }).join('')+'</ul>':'')+
    '<div class="row-btns">'+(missed.length?'<button class="btn primary" type="button" data-act="retryMissed">Retry '+missed.length+' missed</button>':'')+
    '<button class="btn'+(missed.length?'':' primary')+'" type="button" data-act="testHome">Done</button></div></div>';
}

