/* ---------- accounts, encryption and saving ---------- */
/* An account is one document: { salt, iter, iv, ct, updatedAt }. The username is hashed to make the
   document id, and the whole deck state is AES-GCM encrypted with a key derived from the password
   (PBKDF2), so the stored data is unreadable without it. */
var session=null;
var db=null,authReady=false,authMode='login',acctDel=false;
var saveTimer=null,saving=false,dirty=false;
var ITER=310000;
var enc=new TextEncoder(),dec=new TextDecoder();

function setStatus(t){var el=$('#status');if(el)el.textContent=t}
function fail(m){var e=new Error(m);e.friendly=true;return e}
function b64(buf){var b=new Uint8Array(buf),s='';for(var i=0;i<b.length;i++)s+=String.fromCharCode(b[i]);return btoa(s)}
function unb64(s){var bin=atob(s),b=new Uint8Array(bin.length);for(var i=0;i<bin.length;i++)b[i]=bin.charCodeAt(i);return b}
function cleanName(u){return String(u||'').trim().normalize('NFKC').toLowerCase()}
function userId(u){
  return crypto.subtle.digest('SHA-256',enc.encode('nola:'+cleanName(u))).then(function(h){
    return Array.prototype.map.call(new Uint8Array(h),function(x){return ('0'+x.toString(16)).slice(-2)}).join('');
  });
}
function deriveKey(pw,salt,iter){
  return crypto.subtle.importKey('raw',enc.encode(pw),'PBKDF2',false,['deriveKey']).then(function(base){
    return crypto.subtle.deriveKey({name:'PBKDF2',salt:salt,iterations:iter,hash:'SHA-256'},base,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);
  });
}
function encryptState(key,obj){
  var iv=crypto.getRandomValues(new Uint8Array(12));
  return crypto.subtle.encrypt({name:'AES-GCM',iv:iv},key,enc.encode(JSON.stringify(obj))).then(function(ct){return {iv:b64(iv),ct:b64(ct)}});
}
function decryptState(key,doc){
  return crypto.subtle.decrypt({name:'AES-GCM',iv:unb64(doc.iv)},key,unb64(doc.ct)).then(function(pt){return JSON.parse(dec.decode(pt))});
}

/* storage: the shared database when this view has it, plus an encrypted copy in this browser */
function lsKey(id){return 'nola.acct.'+id}
function readLocalDoc(id){try{var r=localStorage.getItem(lsKey(id));return r?JSON.parse(r):null}catch(e){return null}}
function writeLocalDoc(id,doc){try{localStorage.setItem(lsKey(id),JSON.stringify(doc))}catch(e){}}
function readDoc(id,remoteOnly){
  var local=readLocalDoc(id);
  if(!db)return Promise.resolve({doc:local,syncUp:false});
  return db.doc('accounts/'+id).get().then(function(snap){
    var remote=snap.exists?snap.data():null;
    if(remoteOnly)return {doc:remote,syncUp:false};
    if(remote&&local&&(+local.updatedAt||0)>(+remote.updatedAt||0))return {doc:local,syncUp:true};
    return {doc:remote||local,syncUp:!remote&&!!local};
  },function(){return {doc:local,syncUp:false}});
}

/* keep-me-signed-in: the non-extractable key is held in this browser's IndexedDB, never the password */
function idb(){
  return new Promise(function(res,rej){
    try{
      var r=indexedDB.open('nola-auth',1);
      r.onupgradeneeded=function(){r.result.createObjectStore('s')};
      r.onsuccess=function(){res(r.result)};
      r.onerror=function(){rej(r.error)};
    }catch(e){rej(e)}
  });
}
function idbDo(mode,fn){
  return idb().then(function(d){
    return new Promise(function(res,rej){
      var tx=d.transaction('s',mode),req=fn(tx.objectStore('s'));
      tx.oncomplete=function(){res(req&&req.result)};
      tx.onerror=function(){rej(tx.error)};
      tx.onabort=function(){rej(tx.error)};
    });
  });
}
function remember(s){return idbDo('readwrite',function(st){return st.put({id:s.id,name:s.name,key:s.key,salt:s.salt,iter:s.iter},'session')})}
function recall(){return idbDo('readonly',function(st){return st.get('session')})}
function forget(){return idbDo('readwrite',function(st){return st.delete('session')}).catch(function(){})}

/* saving */
function persist(){
  if(!session)return;
  state.updatedAt=Date.now();
  dirty=true;setStatus('Saving…');
  clearTimeout(saveTimer);saveTimer=setTimeout(flush,700);
}
function flush(){
  if(!session||saving||!dirty)return Promise.resolve();
  saving=true;dirty=false;
  var s=session,snap=JSON.parse(JSON.stringify(state)),at=state.updatedAt||Date.now();
  return encryptState(s.key,{name:s.name,state:snap}).then(function(e){
    var doc={v:1,salt:s.salt,iter:s.iter,iv:e.iv,ct:e.ct,updatedAt:at};
    s.doc=doc;
    writeLocalDoc(s.id,doc);
    if(!db){setStatus('Saved in this browser');return}
    return db.doc('accounts/'+s.id).set(doc).then(function(){
      setStatus('Saved to your account');
    },function(err){
      setStatus(err&&err.code==='quota_exceeded'?'Account storage is full. Saved in this browser only.':'Could not reach your account. Saved in this browser.');
    });
  }).catch(function(){setStatus('Could not save. Try again.')}).then(function(){saving=false;if(dirty)flush()});
}
function whenIdle(){return new Promise(function(res){(function w(){if(!saving&&!dirty)res();else setTimeout(w,50)})()})}

/* auth screen */
function setAuthMode(m){
  authMode=m;var su=m==='signup';
  $('#atab-login').setAttribute('aria-selected',su?'false':'true');
  $('#atab-signup').setAttribute('aria-selected',su?'true':'false');
  $('#authPass2Field').hidden=!su;
  $('#authNote').hidden=!su;
  $('#authSubmit').textContent=su?'Create account':'Log in';
  $('#authPass').setAttribute('autocomplete',su?'new-password':'current-password');
  $('#authErr').textContent='';
}
function setAuthErr(m){$('#authErr').textContent=m||''}
function busy(b){
  var btn=$('#authSubmit');btn.disabled=b||!authReady;
  btn.textContent=b?'Working…':(authMode==='signup'?'Create account':'Log in');
}
function authSubmit(){
  if(!authReady)return;
  var u=$('#authUser').value.trim(),p=$('#authPass').value;
  setAuthErr('');
  if(!window.crypto||!crypto.subtle){setAuthErr('This browser cannot do secure sign-in. Try a current version of Chrome, Safari, Firefox or Edge.');return}
  if(authMode==='signup'){
    if(u.length<3||u.length>40){setAuthErr('Pick a username with 3 to 40 characters.');focusSoon($('#authUser'));return}
    if(p.length<8){setAuthErr('Use a password with at least 8 characters.');focusSoon($('#authPass'));return}
    if(p!==$('#authPass2').value){setAuthErr('The two passwords do not match.');focusSoon($('#authPass2'));return}
  }else if(!u||!p){setAuthErr('Enter your username and password.');return}
  busy(true);
  (authMode==='signup'?signUp(u,p):logIn(u,p)).then(function(res){
    busy(false);
    enterSession(res,$('#authKeep').checked);
    if(res.imported){
      legacy=null;try{localStorage.removeItem(LS_KEY)}catch(e){}
      toast('Your earlier cards from this browser were moved into your account.');
    }
  },function(e){
    busy(false);
    setAuthErr(e&&e.friendly?e.message:'Something went wrong. Try again.');
  });
}
function signUp(u,p){
  var id,name=u.trim();
  return userId(u).then(function(i){id=i;return readDoc(id,true)}).then(function(r){
    if(r.doc)throw fail('That username is already taken.');
    var salt=crypto.getRandomValues(new Uint8Array(16));
    return deriveKey(p,salt,ITER).then(function(key){
      var st=legacy?normalizeState(legacy):freshState();
      var s={id:id,name:name,key:key,salt:b64(salt),iter:ITER,doc:null};
      return encryptState(key,{name:name,state:st}).then(function(e){
        var at=Date.now(),doc={v:1,salt:s.salt,iter:ITER,iv:e.iv,ct:e.ct,updatedAt:at};
        st.updatedAt=at;
        var w=db?db.doc('accounts/'+id).set(doc):Promise.resolve();
        return w.then(function(){
          s.doc=doc;writeLocalDoc(id,doc);
          return {s:s,st:st,syncUp:false,imported:!!legacy};
        },function(err){
          throw fail(err&&err.code==='invalid_argument'?'Your access level on this page does not allow creating accounts.':'Could not save the account. Try again.');
        });
      });
    });
  });
}
function logIn(u,p){
  var id,bad=function(){return fail('Username or password is wrong.')};
  return userId(u).then(function(i){id=i;return readDoc(id,false)}).then(function(r){
    var doc=r.doc;if(!doc||!doc.salt||!doc.iv||!doc.ct)throw bad();
    var iter=+doc.iter||ITER;
    return deriveKey(p,unb64(doc.salt),iter).then(function(key){
      return decryptState(key,doc).then(function(pl){
        return {s:{id:id,name:(pl&&pl.name)||u.trim(),key:key,salt:doc.salt,iter:iter,doc:doc},st:normalizeState(pl.state),syncUp:r.syncUp,imported:false};
      },function(){throw bad()});
    });
  });
}
function enterSession(res,keep){
  session=res.s;state=res.st;dirty=false;
  resetSessions();cardFilter='';acctDel=false;
  if(keep)remember(session).catch(function(){});else forget();
  $('#authPass').value='';$('#authPass2').value='';
  $('#auth').hidden=true;$('#app').hidden=false;
  renderAll();renderAccount();setTab('study');
  setStatus(db?'Saved to your account':'Saved in this browser');
  if(res.syncUp){dirty=true;flush()}
  window.scrollTo(0,0);
}
function closeSession(){
  forget();
  session=null;dirty=false;state=freshState();resetSessions();acctDel=false;
  $('#app').hidden=true;$('#auth').hidden=false;
  $('#authUser').value='';$('#authPass').value='';$('#authPass2').value='';$('#authKeep').checked=false;
  setAuthMode('login');focusSoon($('#authUser'));
  window.scrollTo(0,0);
}
function logOut(){
  clearTimeout(saveTimer);
  if(dirty)flush();
  whenIdle().then(closeSession);
}
function renderAccount(){
  var el=$('#account');if(!el||!session)return;
  el.innerHTML='Signed in as <b>'+esc(session.name)+'</b> <button class="btn ghost small" type="button" data-act="logout">Log out</button>';
}
function verifyPw(pw){
  return deriveKey(pw,unb64(session.salt),session.iter).then(function(k){return decryptState(k,session.doc)});
}
function changePassword(){
  var cur=$('#pwCur').value,nw=$('#pwNew').value,n2=$('#pwNew2').value;
  if(!cur||!nw||!n2){toast('Fill in all three password fields.');return}
  if(nw.length<8){toast('Use a new password with at least 8 characters.');return}
  if(nw!==n2){toast('The new passwords do not match.');return}
  verifyPw(cur).then(null,function(){throw fail('Your current password is wrong.')}).then(function(){
    var salt=crypto.getRandomValues(new Uint8Array(16));
    return deriveKey(nw,salt,ITER).then(function(key){
      session.key=key;session.salt=b64(salt);session.iter=ITER;
      state.updatedAt=Date.now();dirty=true;
      return flush().then(whenIdle);
    });
  }).then(function(){
    toast('Password changed');renderAcctAdmin();
    recall().then(function(r){if(r)return remember(session)}).catch(function(){});
  },function(e){toast(e&&e.friendly?e.message:'Could not change the password. Try again.')});
}
function deleteAccount(){
  var pw=$('#delPw').value;
  if(!pw){toast('Enter your password to confirm.');return}
  verifyPw(pw).then(null,function(){throw fail('That password is wrong.')}).then(function(){
    clearTimeout(saveTimer);dirty=false;
    return whenIdle();
  }).then(function(){
    var id=session.id;
    try{localStorage.removeItem(lsKey(id))}catch(e){}
    return db?db.doc('accounts/'+id).delete():null;
  }).then(function(){closeSession();toast('Account deleted')},
    function(e){toast(e&&e.friendly?e.message:'Could not delete the account. Try again.')});
}
function renderAcctAdmin(){
  var el=$('#acctAdmin');if(!el||!session)return;
  var h='<h2>Account</h2><p class="muted">Signed in as <b>'+esc(session.name)+'</b>. Your decks are encrypted with your password before they are saved.</p>'+
    '<form class="pwform" data-form="pw">'+
    '<label class="field"><span>Current password</span><input type="password" id="pwCur" autocomplete="current-password"></label>'+
    '<label class="field"><span>New password</span><input type="password" id="pwNew" autocomplete="new-password"></label>'+
    '<label class="field"><span>Repeat new password</span><input type="password" id="pwNew2" autocomplete="new-password"></label>'+
    '<div class="row-btns"><button class="btn" type="submit">Change password</button></div></form>';
  if(acctDel){
    h+='<form class="confirmbar" data-form="delacct"><span>Delete this account and all its decks? Enter your password to confirm. This cannot be undone.</span>'+
      '<label class="sr" for="delPw">Password</label><input type="password" id="delPw" autocomplete="current-password" placeholder="Password">'+
      '<div class="row-btns"><button class="btn danger solid" type="submit">Delete account</button><button class="btn ghost" type="button" data-act="acctDelNo">Cancel</button></div></form>';
  }else{
    h+='<div class="row-btns"><button class="btn" type="button" data-act="logout">Log out</button><button class="btn danger" type="button" data-act="acctDelAsk">Delete account</button></div>';
  }
  el.innerHTML=h;
}

function boot(){
  setAuthMode('login');
  $('#authSubmit').disabled=true;
  var dbP=(window.claude&&window.claude.use)?Promise.resolve(window.claude.use('db')).catch(function(){return null}):Promise.resolve(null);
  dbP.then(function(d){
    db=d||null;
    return recall().catch(function(){return null});
  }).then(function(r){
    if(!r||!r.key)return null;
    return readDoc(r.id,false).then(function(x){
      if(!x.doc)return null;
      return decryptState(r.key,x.doc).then(function(pl){
        return {s:{id:r.id,name:(pl&&pl.name)||r.name,key:r.key,salt:x.doc.salt,iter:+x.doc.iter||ITER,doc:x.doc},st:normalizeState(pl.state),syncUp:x.syncUp,imported:false};
      },function(){forget();return null});
    });
  }).catch(function(){return null}).then(function(res){
    if(res){enterSession(res,true);return}
    authReady=true;$('#authSubmit').disabled=false;
    $('#authStatus').textContent=db?'Your account is saved to this page\'s private storage, so you can log in from any device.':'Shared storage is not available here, so your account is saved in this browser only.';
    focusSoon($('#authUser'));
  });
}

/* ---------- toast ---------- */
var toastTimer=null;
function toast(msg){
  var el=$('#toast');el.textContent=msg;el.classList.add('on');
  clearTimeout(toastTimer);toastTimer=setTimeout(function(){el.classList.remove('on')},2600);
}

/* ---------- card logic ---------- */
function applyResult(c,ok,noPromote){
  c.seen++;c.last=Date.now();
  if(ok){c.ok++;if(!noPromote)c.lv=Math.min(3,Math.max(c.lv,1)+1)}
  else{c.no++;c.lv=1}
}
function sideOf(card,dir){
  var py=state.settings.showPinyin?card.p:'';
  if(dir==='ft')return {p:card.d,a:card.t,pl:'Meaning',al:'Chinese',fsub:'',sub:card.p};
  if(dir==='tp')return {p:card.t,a:card.p,pl:'Chinese',al:'Pinyin',fsub:'',sub:card.d};
  return {p:card.t,a:card.d,pl:'Chinese',al:'Meaning',fsub:py,sub:card.p};
}
function usable(c,dir){return dir!=='tp'||!!c.p}
function askLabel(dir){return dir==='ft'?'Your answer in Chinese characters':dir==='tp'?'Your answer in pinyin (tone marks or numbers, like ni3 hao3)':'Your answer: the meaning in English'}
function numToMark(s){
  var marks={a:'āáǎà',e:'ēéěè',i:'īíǐì',o:'ōóǒò',u:'ūúǔù','ü':'ǖǘǚǜ'};
  return String(s).replace(/([a-züv:]+)([1-5])/gi,function(m,syl,t){
    syl=syl.replace(/u:|v/gi,'ü');t=+t;if(t===5)return syl;
    var l=syl.toLowerCase(),idx=-1,i;
    if(l.indexOf('a')>-1)idx=l.indexOf('a');
    else if(l.indexOf('e')>-1)idx=l.indexOf('e');
    else if(l.indexOf('ou')>-1)idx=l.indexOf('ou');
    else{for(i=l.length-1;i>=0;i--){if('iouü'.indexOf(l.charAt(i))>-1){idx=i;break}}}
    if(idx<0)return syl;
    return syl.slice(0,idx)+marks[l.charAt(idx)].charAt(t-1)+syl.slice(idx+1);
  });
}
function pyNorm(s){return norm(numToMark(String(s))).replace(/ /g,'')}
function pyFold(s){return pyNorm(s).normalize('NFD').replace(/[̀-ͯ]/g,'')}

function norm(s){return String(s).toLowerCase().normalize('NFC').replace(/[.,!?¿¡;:"“”'’()\[\]，。！？；：、（）《》「」『』…·]/g,'').replace(/\s+/g,' ').trim()}
function fold(s){return norm(s).normalize('NFD').replace(/[̀-ͯ]/g,'')}
function judge(given,answer,py){
  var g=String(given||'').trim();
  if(!g)return {ok:false,close:false};
  var opts=[answer].concat(String(answer).split(/[;；\/]/)).map(function(x){return x.trim()}).filter(Boolean);
  var i;
  var N=py?pyNorm:norm,F=py?pyFold:fold;
  for(i=0;i<opts.length;i++){if(N(g)===N(opts[i]))return {ok:true,close:false}}
  for(i=0;i<opts.length;i++){if(F(g)===F(opts[i]))return {ok:true,close:true}}
  return {ok:false,close:false};
}
function parseBulk(text){
  var good=[],skipped=0;
  String(text).split(/\r?\n/).forEach(function(line){
    var l=line.trim();if(!l)return;
    var parts=null,seps=[/\t+/,/\s*[;；]\s*/,/\s*=\s*/,/\s+[-–—]\s+/];
    for(var si=0;si<seps.length&&!parts;si++){var pp=l.split(seps[si]).map(function(x){return x.trim()}).filter(Boolean);if(pp.length>=2)parts=pp}
    if(!parts)skipped++;
    else if(parts.length>=3)good.push({t:parts[0],p:numToMark(parts[1]),d:parts.slice(2).join('; ')});
    else good.push({t:parts[0],p:'',d:parts[1]});
  });
  return {good:good,skipped:skipped};
}
function newCard(t,d,p){return {id:uid(),t:t,p:p||'',d:d,lv:0,seen:0,ok:0,no:0,last:0}}

/* ---------- rendering: header + progress ---------- */
function renderDeckBar(){
  var sel=$('#deckSelect');
  sel.innerHTML=state.decks.map(function(d){return '<option value="'+esc(d.id)+'">'+esc(d.name)+'</option>'}).join('');
  sel.value=state.activeId;
}
function renderProgress(){
  var d=deck(),counts=[0,0,0,0];
  d.cards.forEach(function(c){counts[c.lv]++});
  var total=d.cards.length,pct=total?Math.round(counts[3]/total*100):0;
  var segs=total?counts.map(function(n,i){return n?'<span class="seg-'+i+'" style="width:'+(n/total*100)+'%" title="'+LV[i]+': '+n+'"></span>':''}).join(''):'';
  var last=d.tests.length?d.tests[d.tests.length-1]:null;
  var lastTxt=last?'Last test '+last.score+'/'+last.total+' · '+Math.round(last.score/last.total*100)+'% · '+fmtDate(last.at):'No tests taken yet';
  var label=LV.map(function(n,i){return n+' '+counts[i]}).join(', ');
  $('#progress').innerHTML=
    '<div class="prog-top"><div class="prog-main"><span class="prog-pct">'+pct+'%</span><span class="prog-cap">mastered · '+pl(total,'card')+'</span></div>'+
    '<span class="prog-last">'+esc(lastTxt)+'</span></div>'+
    '<div class="bar" role="img" aria-label="'+esc(label)+'">'+segs+'</div>'+
    '<ul class="legend">'+LV.map(function(n,i){return '<li><span class="dot" style="--c:var(--lv'+i+')"></span>'+n+' <b>'+counts[i]+'</b></li>'}).join('')+'</ul>';
