<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Nola</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;600&family=Figtree:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;600&display=swap">
<style>
/* Layout: one centered column. Progress strip on top, tabs below, and a ruled index card as the stage. */
:root{
  --bg:#EDF0F5;
  --surface:#FFFFFF;
  --surface-2:#F4F6FA;
  --fg:#16203A;
  --muted:#586380;
  --line:#D5DBE7;
  --accent:#2848B8;
  --accent-fg:#FFFFFF;
  --accent-soft:#E3E9FB;
  --rule-red:#D6455D;
  --rule-blue:#D3DCF1;
  --lv0:#A3ADC4;
  --lv1:#D9822B;
  --lv2:#1C93A3;
  --lv3:#2A9858;
  --good:#1F7A47;
  --good-soft:#E3F3E9;
  --bad:#B93434;
  --bad-soft:#FBE8E8;
  --font-ui:'Figtree',system-ui,-apple-system,'Segoe UI',sans-serif;
  --font-card:'Bitter','Noto Serif SC',Georgia,'Songti SC','Noto Serif CJK SC','Hiragino Mincho ProN',serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0F1424;--surface:#182038;--surface-2:#1F2848;--fg:#E8ECF8;--muted:#9BA7C6;--line:#2C3659;
    --accent:#86A0FF;--accent-fg:#0F1424;--accent-soft:#242F5A;--rule-red:#FF6B82;--rule-blue:#28335E;
    --lv0:#6F7A9C;--lv1:#F0A24F;--lv2:#3FC1D0;--lv3:#4CC27F;
    --good:#5AD38C;--good-soft:#1B3A2B;--bad:#FF8585;--bad-soft:#47232B;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0F1424;--surface:#182038;--surface-2:#1F2848;--fg:#E8ECF8;--muted:#9BA7C6;--line:#2C3659;
  --accent:#86A0FF;--accent-fg:#0F1424;--accent-soft:#242F5A;--rule-red:#FF6B82;--rule-blue:#28335E;
  --lv0:#6F7A9C;--lv1:#F0A24F;--lv2:#3FC1D0;--lv3:#4CC27F;
  --good:#5AD38C;--good-soft:#1B3A2B;--bad:#FF8585;--bad-soft:#47232B;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{
  background:var(--bg);color:var(--fg);
  font:400 1rem/1.5 var(--font-ui);
  padding-block:20px 72px;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
h1,h2,h3,p,ul{margin:0}
ul{padding:0;list-style:none}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.muted{color:var(--muted)}

.shell{max-width:44rem;margin:0 auto;display:flex;flex-direction:column;gap:1.25rem;min-width:0}

/* header */
.top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem}
.brand{font:600 1.5rem/1.2 var(--font-card);letter-spacing:-.01em}
.deckbar{display:flex;gap:.5rem;align-items:center;min-width:0;max-width:100%}
select,input[type=text],input[type=password],textarea{
  background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:.55rem .75rem;min-width:0;max-width:100%;
}
select{cursor:pointer}
textarea{width:100%;resize:vertical;min-height:7rem;line-height:1.5}
input[type=text],input[type=password]{width:100%}
input[type=checkbox]{width:1.1rem;height:1.1rem;accent-color:var(--accent)}
.deckbar select{max-width:min(16rem,52vw)}

/* buttons */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.4rem;
  border:1px solid var(--line);background:var(--surface);color:var(--fg);
  padding:.55rem .95rem;border-radius:8px;font-weight:600;font-size:.9rem;cursor:pointer;
}
.btn:hover:not(:disabled){background:var(--surface-2)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.btn.primary:hover:not(:disabled){filter:brightness(1.08);background:var(--accent)}
.btn.ghost{border-color:transparent;background:transparent;color:var(--muted)}
.btn.ghost:hover:not(:disabled){background:var(--surface-2);color:var(--fg)}
.btn.danger{color:var(--bad);border-color:var(--bad)}
.btn.danger.solid{background:var(--bad);color:var(--surface);border-color:var(--bad)}
.btn.small{padding:.3rem .65rem;font-size:.8rem}
.btn.big{padding:.8rem 1.2rem;font-size:1rem}
.btn.again{border-color:var(--lv1);color:var(--fg)}
.btn.again:hover:not(:disabled){background:var(--surface-2)}
.btn.wide{width:100%}

.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.1rem}

/* progress */
.progress{display:flex;flex-direction:column;gap:.8rem}
.prog-top{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.25rem .75rem}
.prog-main{display:flex;align-items:baseline;gap:.5rem;min-width:0}
.prog-pct{font:600 2rem/1 var(--font-card);font-variant-numeric:tabular-nums}
.prog-cap{color:var(--muted);font-size:.9rem}
.prog-last{color:var(--muted);font-size:.85rem;font-variant-numeric:tabular-nums}
.bar{display:flex;height:.7rem;border-radius:99px;overflow:hidden;background:var(--surface-2);border:1px solid var(--line)}
.bar span{display:block;height:100%}
.seg-0{background:var(--lv0)}.seg-1{background:var(--lv1)}.seg-2{background:var(--lv2)}.seg-3{background:var(--lv3)}
.legend{display:flex;flex-wrap:wrap;gap:.35rem 1.1rem;font-size:.85rem;color:var(--muted)}
.legend li{display:flex;align-items:center;gap:.4rem}
.legend b{color:var(--fg);font-variant-numeric:tabular-nums}
.dot{width:.65rem;height:.65rem;border-radius:2px;background:var(--c,var(--lv0));flex:none}

/* tabs */
.tabs{display:flex;gap:.25rem;border-bottom:1px solid var(--line)}
.tab{
  flex:1;background:none;border:0;border-bottom:3px solid transparent;margin-bottom:-1px;
  padding:.7rem .5rem;font-weight:600;color:var(--muted);cursor:pointer;
}
.tab:hover{color:var(--fg)}
.tab[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--accent)}

/* views */
.view{display:flex;flex-direction:column;gap:1rem;min-width:0}
.start{display:flex;flex-direction:column;gap:1rem}
.start h2,.results h2{font:600 1.25rem/1.3 var(--font-card)}
.lead{color:var(--muted)}
.opts-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.9rem}
.field{display:flex;flex-direction:column;gap:.3rem;min-width:0}
.field>span,.label{font-size:.78rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.check{display:flex;align-items:center;gap:.6rem;cursor:pointer}
.recent{display:flex;flex-direction:column;gap:.25rem;font-size:.9rem;color:var(--muted);font-variant-numeric:tabular-nums}
.recent h3{font-size:.78rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:.15rem}
.empty{display:flex;flex-direction:column;align-items:flex-start;gap:.75rem;padding:1.5rem 0}
.empty h2{font:600 1.25rem var(--font-card)}

.session-head{display:flex;align-items:center;justify-content:space-between;gap:.75rem;font-size:.9rem;color:var(--muted);font-variant-numeric:tabular-nums}
.minibar{height:.3rem;background:var(--line);border-radius:99px;overflow:hidden}
.minibar span{display:block;height:100%;background:var(--accent);transition:width .3s}

/* index card */
.flip{perspective:1400px;width:100%;cursor:pointer;border-radius:12px;-webkit-tap-highlight-color:transparent}
.flip-inner{display:grid;transition:transform .5s cubic-bezier(.3,.7,.2,1);transform-style:preserve-3d}
.flip.flipped .flip-inner{transform:rotateY(180deg)}
.face{
  grid-area:1/1;position:relative;overflow:hidden;
  background:var(--surface);border:1px solid var(--line);border-radius:12px;
  min-height:17rem;display:flex;flex-direction:column;
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
  box-shadow:0 1px 0 var(--line),0 10px 24px -18px rgba(22,32,58,.45);
}
.face.back{transform:rotateY(180deg)}
.face.solo{min-height:12rem}
.face::before{content:"";position:absolute;left:0;right:0;top:3rem;bottom:0;
  background:repeating-linear-gradient(to bottom,transparent 0,transparent calc(2rem - 1px),var(--rule-blue) calc(2rem - 1px),var(--rule-blue) 2rem);
}
.face::after{content:"";position:absolute;left:0;right:0;top:3rem;height:2px;background:var(--rule-red)}
.face-head{position:relative;z-index:1;height:3rem;display:flex;align-items:center;justify-content:space-between;padding:0 1.1rem}
.eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.face-body{
  position:relative;z-index:1;flex:1;display:flex;flex-direction:column;gap:.7rem;align-items:center;justify-content:center;text-align:center;
  padding:1.5rem 1.4rem 1.7rem;font-family:var(--font-card);font-weight:600;
  font-size:clamp(1.7rem,7vw,2.6rem);line-height:1.25;overflow-wrap:anywhere;text-wrap:balance;
}
.face-body.s1{font-size:clamp(1.4rem,5.5vw,2rem)}
.face-body.s2{font-size:clamp(1.15rem,4.4vw,1.5rem);font-weight:400}
.face-body.s3{font-size:1.05rem;font-weight:400}
.hint{font-size:.82rem;color:var(--muted);text-align:center}
.face-sub{font:400 1.05rem/1.3 var(--font-ui);color:var(--muted)}
.py{display:block;font:400 .85rem/1.3 var(--font-ui);color:var(--muted)}
.account{font-size:.85rem;color:var(--muted);display:flex;flex-wrap:wrap;align-items:center;gap:.25rem .5rem}
.account b{color:var(--fg)}
.brandwrap{display:flex;flex-direction:column;gap:.1rem;min-width:0}
.tagline{font-size:.8rem;letter-spacing:.06em;color:var(--muted)}
.auth{max-width:26rem;margin:6vh auto 0;display:flex;flex-direction:column;gap:1.25rem}
.auth .brand{font-size:2.6rem}
.auth-card{display:flex;flex-direction:column;gap:1.1rem}
.auth-card .add-form{gap:.9rem}
.err{color:var(--bad);font-size:.9rem;min-height:1.35em}
.pwform{display:grid;gap:.7rem;max-width:22rem}
kbd{font:600 .75rem var(--font-ui);padding:.05rem .4rem;border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;background:var(--surface)}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
.actions .only{grid-column:1/-1}

/* test */
.answer-form{display:flex;flex-direction:column;gap:.7rem}
.answer-input{font-size:1.15rem;padding:.8rem 1rem;border-radius:10px}
.row-btns{display:flex;flex-wrap:wrap;gap:.6rem}
.feedback{display:flex;flex-direction:column;gap:.35rem;padding:.9rem 1rem;border-radius:10px;border:1px solid var(--line);background:var(--surface)}
.feedback.ok{border-color:var(--good);background:var(--good-soft)}
.feedback.bad{border-color:var(--bad);background:var(--bad-soft)}
.fb-title{font-weight:700}
.feedback.ok .fb-title{color:var(--good)}
.feedback.bad .fb-title{color:var(--bad)}
.ans{font-family:var(--font-card);font-weight:600;overflow-wrap:anywhere}
.opts{display:grid;gap:.5rem}
.opt{
  display:flex;gap:.75rem;align-items:center;text-align:left;width:100%;min-width:0;
  padding:.8rem 1rem;border:1px solid var(--line);background:var(--surface);border-radius:10px;
  color:var(--fg);font-weight:500;cursor:pointer;overflow-wrap:anywhere;
}
.opt:hover:not(:disabled){border-color:var(--accent)}
.opt:disabled{cursor:default;color:var(--fg);opacity:1}
.opt .k{flex:none;width:1.5rem;height:1.5rem;display:grid;place-items:center;border-radius:5px;background:var(--surface-2);font-size:.75rem;font-weight:700;color:var(--muted)}
.opt.right{border-color:var(--good);background:var(--good-soft)}
.opt.wrong{border-color:var(--bad);background:var(--bad-soft)}

.results{display:flex;flex-direction:column;gap:1rem}
.score{font:600 3rem/1 var(--font-card);font-variant-numeric:tabular-nums}
.score small{font-size:1.25rem;color:var(--muted);font-weight:400}
.missed{display:flex;flex-direction:column}
.missed li{padding:.6rem 0;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:.1rem;min-width:0;overflow-wrap:anywhere}
.missed li:first-child{border-top:1px solid var(--line)}
.missed .p{font-weight:600}
.missed .g{font-size:.85rem;color:var(--muted)}

/* cards view */
.add-grid{display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:.75rem}
.add-form{display:flex;flex-direction:column;gap:.9rem}
details.bulk{border:1px solid var(--line);border-radius:12px;background:var(--surface)}
details.bulk summary{padding:.85rem 1.1rem;font-weight:600;cursor:pointer}
.bulk-body{padding:0 1.1rem 1.1rem;display:flex;flex-direction:column;gap:.75rem}
.bulk-foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem}
.list-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem}
.list-head h2{font:600 1.1rem var(--font-card)}
.list-head input{max-width:14rem}
.rows{display:flex;flex-direction:column}
.row{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto auto;gap:.4rem .9rem;align-items:center;
  padding:.7rem 0;border-bottom:1px solid var(--line);
}
.row:first-child{border-top:1px solid var(--line)}
.cell-t{font-family:var(--font-card);font-weight:600;overflow-wrap:anywhere}
.cell-d{overflow-wrap:anywhere;color:var(--muted)}
.pill{display:inline-flex;align-items:center;gap:.4rem;font-size:.75rem;font-weight:600;color:var(--muted);white-space:nowrap}
.pill::before{content:"";width:.6rem;height:.6rem;border-radius:2px;background:var(--c)}
.pill[data-lv="0"]{--c:var(--lv0)}.pill[data-lv="1"]{--c:var(--lv1)}.pill[data-lv="2"]{--c:var(--lv2)}.pill[data-lv="3"]{--c:var(--lv3)}
.row-actions{display:flex;gap:.25rem}
.row.editing{grid-template-columns:1fr 1fr;}
.row.editing form{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:.6rem}
.row.editing .row-btns{grid-column:1/-1}
.row.confirm{grid-template-columns:minmax(0,1fr) auto}
.more{padding:.75rem 0;font-size:.85rem;color:var(--muted)}
.admin{display:flex;flex-direction:column;gap:1rem}
.admin h2{font:600 1.1rem var(--font-card)}
.rename{display:flex;gap:.5rem;flex-wrap:wrap}
.rename input{flex:1;min-width:10rem}
.note{padding:.8rem 1rem;border-radius:10px;background:var(--accent-soft);font-size:.9rem}
.confirmbar{display:flex;flex-direction:column;gap:.6rem;padding:.9rem 1rem;border:1px solid var(--bad);border-radius:10px;background:var(--bad-soft)}

.status{font-size:.8rem;color:var(--muted);text-align:center}

.toast-wrap{
  position:fixed;left:max(16px,env(safe-area-inset-left,0px));right:max(16px,env(safe-area-inset-right,0px));
  bottom:calc(16px + env(safe-area-inset-bottom,0px));display:flex;justify-content:center;pointer-events:none;
}
.toast{background:var(--fg);color:var(--bg);padding:.6rem 1rem;border-radius:99px;font-size:.9rem;font-weight:500;opacity:0;transform:translateY(8px);transition:opacity .2s,transform .2s;max-width:100%}
.toast.on{opacity:1;transform:none}

@media (max-width:600px){
  .add-grid{grid-template-columns:1fr}
  .row{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"t t" "d d" "p a"}
  .row .cell-t{grid-area:t}.row .cell-d{grid-area:d}.row .pill{grid-area:p}.row .row-actions{grid-area:a}
  .row.editing form{grid-template-columns:1fr}
  .prog-pct{font-size:1.7rem}
}
@media (prefers-reduced-motion: reduce){
  .flip-inner,.minibar span,.toast{transition:none}
}
</style>

<div class="auth" id="auth">
  <div class="brandwrap">
    <h1 class="brand">Nola</h1>
    <p class="tagline">no language barriers</p>
  </div>
  <div class="panel auth-card">
    <div class="tabs" role="tablist" aria-label="Account">
      <button class="tab" type="button" role="tab" id="atab-login" data-act="authLogin" aria-selected="true">Log in</button>
      <button class="tab" type="button" role="tab" id="atab-signup" data-act="authSignup" aria-selected="false">Create account</button>
    </div>
    <form id="authForm" class="add-form" novalidate>
      <label class="field"><span>Username</span><input type="text" id="authUser" autocomplete="username" autocapitalize="off" spellcheck="false" maxlength="40"></label>
      <label class="field"><span>Password</span><input type="password" id="authPass" autocomplete="current-password"></label>
      <label class="field" id="authPass2Field" hidden><span>Repeat password</span><input type="password" id="authPass2" autocomplete="new-password"></label>
      <label class="check"><input type="checkbox" id="authKeep"> Keep me signed in on this device</label>
      <p class="note" id="authNote" hidden>Your decks are encrypted with your password. There is no password reset, so if you forget it your cards cannot be recovered.</p>
      <p class="err" id="authErr" role="alert"></p>
      <button class="btn primary big wide" type="submit" id="authSubmit" disabled>Log in</button>
    </form>
  </div>
  <p class="status" id="authStatus" role="status">Connecting…</p>
</div>

<div class="shell" id="app" hidden>
  <header class="top">
    <div class="brandwrap">
      <h1 class="brand">Nola</h1>
      <p class="tagline">no language barriers</p>
    </div>
    <div class="deckbar">
      <label class="sr" for="deckSelect">Deck</label>
      <select id="deckSelect"></select>
      <button class="btn" type="button" data-act="newDeck">New deck</button>
    </div>
  </header>

  <form id="newDeckForm" class="panel add-form" hidden>
    <label class="field"><span>Deck name</span><input type="text" id="newDeckName" maxlength="60" autocomplete="off" placeholder="e.g. German travel words"></label>
    <div class="row-btns">
      <button class="btn primary" type="submit">Create deck</button>
      <button class="btn ghost" type="button" data-act="cancelNewDeck">Cancel</button>
    </div>
  </form>

  <p class="account" id="account"></p>

  <section class="panel progress" aria-label="Deck progress" id="progress"></section>

  <nav class="tabs" role="tablist" aria-label="Sections">
    <button class="tab" role="tab" id="tab-study" data-tab="study" aria-selected="true" aria-controls="view-study">Study</button>
    <button class="tab" role="tab" id="tab-test" data-tab="test" aria-selected="false" aria-controls="view-test">Test</button>
    <button class="tab" role="tab" id="tab-cards" data-tab="cards" aria-selected="false" aria-controls="view-cards">Cards</button>
  </nav>

  <main>
    <section class="view" id="view-study" role="tabpanel" aria-labelledby="tab-study"><div id="studyBody"></div></section>
    <section class="view" id="view-test" role="tabpanel" aria-labelledby="tab-test" hidden><div id="testBody"></div></section>
    <section class="view" id="view-cards" role="tabpanel" aria-labelledby="tab-cards" hidden>
      <div id="sampleNote"></div>
      <form class="panel add-form" id="addForm">
        <div class="add-grid">
          <label class="field"><span>Chinese</span><input type="text" id="addTerm" lang="zh-Hans" autocomplete="off" placeholder="e.g. 窗户"></label>
          <label class="field"><span>Pinyin</span><input type="text" id="addPy" autocomplete="off" autocapitalize="off" placeholder="e.g. chuang1hu or chuānghu"></label>
          <label class="field"><span>Meaning</span><input type="text" id="addDef" autocomplete="off" placeholder="e.g. window"></label>
        </div>
        <div class="row-btns"><button class="btn primary" type="submit">Add card</button></div>
      </form>
      <details class="bulk" id="bulkBox">
        <summary>Paste many cards at once</summary>
        <div class="bulk-body">
          <p class="muted">One card per line: Chinese ; pinyin ; meaning. Pinyin is optional, so Chinese ; meaning works too. Separate fields with a semicolon, equals sign, tab or spaced dash. Pasting columns from a spreadsheet works. Tone numbers such as ni3 hao3 are turned into tone marks.</p>
          <label class="sr" for="bulkText">Cards to import</label>
          <textarea id="bulkText" placeholder="你好 ; nǐ hǎo ; hello&#10;谢谢 ; xie4xie ; thank you&#10;书 ; book"></textarea>
          <div class="bulk-foot">
            <span class="muted" id="bulkPreview">Nothing to import yet.</span>
            <button class="btn primary" type="button" id="bulkBtn" data-act="importBulk" disabled>Add cards</button>
          </div>
        </div>
      </details>
      <div class="list-head">
        <h2 id="listTitle">Cards</h2>
        <label class="sr" for="cardSearch">Search cards</label>
        <input type="text" id="cardSearch" placeholder="Search this deck" autocomplete="off">
      </div>
      <ul class="rows" id="cardList"></ul>
      <div class="panel admin" id="deckAdmin"></div>
      <div class="panel admin" id="acctAdmin"></div>
    </section>
