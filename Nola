/* ---------- state ---------- */
function sampleDeck(){
  var raw=[['你好','nǐ hǎo','hello',3],['谢谢','xièxie','thank you',3],['请','qǐng','please',3],['早上好','zǎoshang hǎo','good morning',2],['你好吗？','nǐ hǎo ma?','how are you?',2],['书','shū','book',2],['窗户','chuānghu','window',1],['说','shuō','to speak',1],['吃','chī','to eat',1],['明天','míngtiān','tomorrow',0],['总是','zǒngshì','always',0],['学习','xuéxí','to study / to learn',0]];
  return {id:uid(),name:'Chinese basics (example)',sample:true,
    cards:raw.map(function(r){return {id:uid(),t:r[0],p:r[1],d:r[2],lv:r[3],seen:r[3]?1:0,ok:r[3]?1:0,no:0,last:0}}),tests:[]};
}
function defaults(){return {dir:'tf',inclMastered:false,showPinyin:true,studyN:20,testN:10,testMode:'type'}}
function freshState(){var d=sampleDeck();return {v:1,updatedAt:0,activeId:d.id,settings:defaults(),decks:[d]}}
function normalizeState(s){
  var out={v:1,updatedAt:+s.updatedAt||0,settings:Object.assign(defaults(),s.settings||{}),decks:[]};
  (s.decks||[]).forEach(function(d){
