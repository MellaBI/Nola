  }else if(confirmAdmin==='delete'){
    html+='<div class="confirmbar"><span>Delete “'+esc(d.name)+'” and its '+pl(d.cards.length,'card')+'? This cannot be undone.</span><div class="row-btns"><button class="btn danger solid" type="button" data-act="deleteYes">Delete deck</button><button class="btn ghost" type="button" data-act="adminNo">Cancel</button></div></div>';
