  override:function(){if(test&&test.cur&&test.cur.checked){test.cur.correct=true;test.cur.close=false;renderTestAsk($('#testBody'))}},
  next:nextQuestion,
  pick:function(el){pickOption(+el.dataset.i)},
  retryMissed:function(){var ids=test.results.filter(function(r){return !r.correct}).map(function(r){return r.id});startTest(ids)},
  testHome:function(){test=null;renderTest()},
  editCard:function(el){editing=el.dataset.id;confirmCard=null;renderCardList()},
  cancelEdit:function(){editing=null;renderCardList()},
  delCard:function(el){confirmCard=el.dataset.id;editing=null;renderCardList()},
  delCardNo:function(){confirmCard=null;renderCardList()},
  delCardYes:function(el){
    var d=deck();d.cards=d.cards.filter(function(c){return c.id!==el.dataset.id});
    confirmCard=null;persist();renderAll();toast('Card deleted');
  },
  importBulk:function(){
    var r=parseBulk($('#bulkText').value),d=deck(),have={};
    d.cards.forEach(function(c){have[norm(c.t)+'|'+norm(c.d)]=1});
    var added=0,dupes=0;
    r.good.forEach(function(g){var k=norm(g.t)+'|'+norm(g.d);if(have[k]){dupes++;return}have[k]=1;d.cards.push(newCard(g.t,g.d,g.p));added++});
    $('#bulkText').value='';updateBulkPreview();
    persist();renderAll();
    toast('Added '+pl(added,'card')+(dupes?', skipped '+dupes+' duplicate'+(dupes===1?'':'s'):'')+(r.skipped?', '+pl(r.skipped,'line')+' had no separator':''));
  },
  resetAsk:function(){confirmAdmin='reset';renderAdmin()},
  deleteAsk:function(){confirmAdmin='delete';renderAdmin()},
  adminNo:function(){confirmAdmin=null;renderAdmin()},
  resetYes:function(){
    var d=deck();d.cards.forEach(function(c){c.lv=0;c.seen=0;c.ok=0;c.no=0;c.last=0});d.tests=[];
    confirmAdmin=null;resetSessions();persist();renderAll();toast('Progress reset');
  },
  deleteYes:function(){
    state.decks=state.decks.filter(function(x){return x.id!==state.activeId});
    if(!state.decks.length)state.decks.push({id:uid(),name:'My words',cards:[],tests:[]});
    state.activeId=state.decks[0].id;
    resetSessions();persist();renderAll();toast('Deck deleted');
  }
};

function updateBulkPreview(){
  var r=parseBulk($('#bulkText').value);
  var el=$('#bulkPreview'),btn=$('#bulkBtn');
  if(!$('#bulkText').value.trim()){el.textContent='Nothing to import yet.';btn.disabled=true;btn.textContent='Add cards';return}
  el.textContent=pl(r.good.length,'card')+' ready'+(r.skipped?' · '+pl(r.skipped,'line')+' skipped (no separator)':'');
  btn.disabled=!r.good.length;btn.textContent=r.good.length?'Add '+pl(r.good.length,'card'):'Add cards';
}

document.addEventListener('click',function(e){
  var t=e.target.closest('[data-tab]');
  if(t){setTab(t.dataset.tab);return}
  var el=e.target.closest('[data-act]');
  if(!el)return;
  var fn=A[el.dataset.act];
  if(fn)fn(el,e);
});

document.addEventListener('change',function(e){
  var el=e.target;
  if(el.id==='deckSelect'){state.activeId=el.value;resetSessions();cardFilter='';$('#cardSearch').value='';persist();renderAll();return}
  var k=el.dataset&&el.dataset.set;
  if(!k)return;
  var s=state.settings;
  if(k==='inclMastered'||k==='showPinyin')s[k]=el.checked;
  else if(k==='studyN'||k==='testN')s[k]=el.value==='all'?'all':+el.value;
  else s[k]=el.value;
  persist();renderStudy();renderTest();
});

document.addEventListener('submit',function(e){
  e.preventDefault();
  var f=e.target,id=f.id,kind=f.dataset.form;
  if(id==='authForm'){authSubmit();return}
  if(kind==='pw'){changePassword();return}
  if(kind==='delacct'){deleteAccount();return}
  if(id==='newDeckForm'){
    var name=$('#newDeckName').value.trim()||'Untitled deck';
    var d={id:uid(),name:name,cards:[],tests:[]};
    state.decks.push(d);state.activeId=d.id;resetSessions();
    $('#newDeckName').value='';f.hidden=true;
    persist();renderAll();setTab('cards');focusSoon($('#addTerm'));
  }else if(id==='addForm'){
    var t=$('#addTerm').value.trim(),df=$('#addDef').value.trim(),pn=numToMark($('#addPy').value.trim());
    if(!t||!df){toast('Fill in the Chinese and the meaning.');focusSoon(!t?$('#addTerm'):$('#addDef'));return}
    deck().cards.push(newCard(t,df,pn));
    $('#addTerm').value='';$('#addPy').value='';$('#addDef').value='';
    persist();renderAll();toast('Added “'+t+'”');focusSoon($('#addTerm'));
  }else if(id==='answerForm'){
    checkTyped(false);
  }else if(kind==='edit'){
    var c=cardById(f.dataset.id),nt=$('#editT').value.trim(),nd=$('#editD').value.trim(),np=numToMark($('#editP').value.trim());
    if(!nt||!nd){toast('Both fields need text.');return}
    if(c){c.t=nt;c.d=nd;c.p=np}
    editing=null;persist();renderAll();
  }else if(kind==='rename'){
    var nn=$('#renameInput').value.trim();
    if(!nn){toast('A deck needs a name.');return}
    deck().name=nn;persist();renderDeckBar();renderAdmin();toast('Deck renamed');
  }
});

document.addEventListener('input',function(e){
  if(e.target.id==='bulkText')updateBulkPreview();
  else if(e.target.id==='cardSearch'){cardFilter=e.target.value;renderCardList()}
});

document.addEventListener('keydown',function(e){
  if(e.metaKey||e.ctrlKey||e.altKey)return;
  var t=e.target,tag=t&&t.tagName;
  var typing=tag==='INPUT'||tag==='TEXTAREA'||tag==='SELECT';
  if(typing)return;
  if(tab==='study'&&study&&study.phase==='run'){
    if((e.key===' '||e.key==='Enter')&&tag==='BUTTON')return;
    if(e.key===' '||e.key==='Enter'){
      e.preventDefault();
      if(t&&t.id==='flipCard'&&e.repeat)return;
      if(!study.flipped)flipStudy();
      return;
    }
    if(study.flipped){
      if(e.key==='1'||e.key==='ArrowLeft'){e.preventDefault();answerStudy(false)}
      else if(e.key==='2'||e.key==='ArrowRight'){e.preventDefault();answerStudy(true)}
    }
  }else if(tab==='test'&&test&&test.phase==='ask'){
    var cur=test.cur;
    if(test.mode==='mc'&&!cur.checked&&/^[1-9]$/.test(e.key)){e.preventDefault();pickOption(+e.key-1);return}
    if(cur.checked&&e.key==='Enter'&&tag!=='BUTTON'){e.preventDefault();nextQuestion()}
  }
});

/* ---------- boot ---------- */
boot();
})();
</script>

</body></html>
